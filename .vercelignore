# Vercel ignore file - Files/folders to exclude from deployment

# Development files
_backup_debug_files/
.vscode/
.idea/
.git/

# Python virtual environment and cache
backend/venv/
backend/__pycache__/
backend/**/__pycache__/

# Node.js development files
node_modules/
frontend/node_modules/
*.log
npm-debug.log*
yarn-debug.log*

# Environment files (use Vercel dashboard for env vars)
.env
.env.local
.env.development.local

# Database files (not needed in deployment)
*.db
*.db-journal
*.db-wal
*.db-shm

# Cache and temporary files
.cache/
*.tmp
*.temp
.eslintcache
*.tsbuildinfo

# Development documentation
specs/
REQUEST_GUIDELINES.md

# OS files
.DS_Store
Thumbs.db